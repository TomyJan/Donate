# 保留所有键，不启用的可选项留空；修改后重启。
# 相对路径以启动目录为准；密钥与凭据不要公开。

# ==================== 基础配置 ====================

APP_ENV=production
                                                # 环境：production / development；进程环境变量优先。

APP_NAME=donate
                                                # 程序标识：小写字母和 -，字母开头结尾，最多 63 位。

LISTEN_ADDR=127.0.0.1:8080
                                                # 监听地址。

PUBLIC_URL=https://donate.example.com
                                                # 对外站点地址，生产环境使用 HTTPS。

REAL_IP_HEADER=""
                                                # 真实 IP 头，如 X-Real-IP；留空用连接 IP，反代须覆盖。

# ==================== 数据库与备份 ====================

DATA_DIR=data
                                                # 数据库与锁目录；文件名为 APP_NAME.db / .lock。

BACKUP_DIR=data/backups
                                                # 数据库备份目录。

BACKUP_RETENTION_DAYS=7
                                                # 备份保留天数；0 不自动清理。

# ==================== 日志 ====================

LOG_DIR=data/logs
                                                # 文件日志目录；每天新建，单卷 20 MiB。
                                                # 续卷追加 .2、.3。

LOG_OUTPUTS=console,log,jsonl
                                                # 输出目的：console / log / jsonl；逗号分隔，至少一项。

LOG_LEVEL=INFO
                                                # 日志级别：DEBUG / INFO / WARN / ERROR。

LOG_RETENTION_DAYS=30
                                                # 日志保留天数；0 不清理，仅处理当前 APP_NAME。

# ==================== 安全与权限 ====================

APP_SECRET=""
                                                # Base64 编码的 32 字节密钥，生产必填且保持不变。
                                                # 生成：openssl rand -base64 32

ADMIN_USER_IDS=""
                                                # 管理员站内 ID，逗号分隔；可先留空，登录后取得。

# ==================== 访问统计 ====================

UMAMI_SCRIPT_URL=""
                                                # Umami 脚本 HTTPS 地址；与网站 ID 同填或同空。

UMAMI_WEBSITE_ID=""
                                                # Umami 网站 ID。

# ==================== OIDC 登录 ====================

OIDC_ISSUER=""
                                                # OIDC 发行者地址；留空关闭 OIDC 登录。

OIDC_CLIENT_ID=""
                                                # OIDC 客户端 ID。

OIDC_CLIENT_SECRET=""
                                                # OIDC 客户端密钥；按服务端要求填写。

OIDC_ID=oidc
                                                # 回调标识；小写字母开头，可用数字、_、-，最多 32 位，不可为 qq。

OIDC_NAME=OIDC
                                                # 登录和绑定入口显示的名称。

OIDC_ICON_URL=""
                                                # 可选 HTTPS 图标地址。

# ==================== QQ 登录 ====================

QQ_APP_ID=""
                                                # QQ 应用 ID；与密钥同空可关闭 QQ 登录。

QQ_APP_SECRET=""
                                                # QQ 互联应用密钥。

QQ_USE_UNIONID=false
                                                # 改用 UnionID 绑定，仍保存 OpenID；需已开通权限。

# ==================== 易支付 ====================

EPAY_URL=""
                                                # 彩虹易支付网关地址；留空关闭支付。

EPAY_PID=""
                                                # 易支付商户 ID。

EPAY_PROTOCOL=v2
                                                # 接口版本：v2 / v1。

EPAY_PRIVATE_KEY_FILE=""
                                                # V2 商户私钥文件；与下一项二选一，文件优先。

EPAY_PRIVATE_KEY=""
                                                # V2 商户私钥 PEM / Base64；使用文件时留空。

EPAY_PUBLIC_KEY_FILE=""
                                                # V2 平台公钥文件；与下一项二选一，文件优先。

EPAY_PUBLIC_KEY=""
                                                # V2 平台公钥 PEM / Base64；使用文件时留空。

EPAY_KEY=""
                                                # V1 商户密钥，仅 EPAY_PROTOCOL=v1 时使用。

EPAY_REDIRECT_HOSTS=""
                                                # 额外支付跳转域名，逗号分隔；自动允许网关域名。

# ==================== IP 属地 ====================

GEO_MODE=online
                                                # 属地：online / local / disabled；local 才读取和更新本地库。

GEO_XDB_IPV4=data/ipdb/ip2region_v4.xdb
                                                # 优先 IPv4 XDB；不用则留空。

GEO_XDB_IPV6=data/ipdb/ip2region_v6.xdb
                                                # 优先 IPv6 XDB；不用则留空。

GEO_DATABASE=data/ipdb/GeoLite2-City.mmdb
                                                # 可选 City MMDB 回退；不用则留空，不能用 Country / ASN 库。

GEO_ONLINE_FALLBACK=true
                                                # 本地库就绪后允许在线核验；false 关闭核验。
                                                # 没有可用本地库时仍临时在线查询，不控制库下载。

# ==================== IP 库更新 ====================

GEO_UPDATE_DAYS=7
                                                # 库更新间隔天数；0 或空 URL 关闭下载，仅 local 生效。
                                                # 缺失或损坏立即入队；后台重试，校验后热重载。

GEO_XDB_IPV4_URL=""
                                                # IPv4 XDB 下载地址；可含查询密钥或代理地址。

GEO_XDB_IPV6_URL=""
                                                # IPv6 XDB 下载地址；支持原始文件 / gzip / tar.gz / zip。

GEO_DATABASE_URL=""
                                                # City MMDB 下载地址；生产使用 HTTPS。
