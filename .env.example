APP_ENV=production                            # 运行环境：production / development；当前目录 .env 自动加载，进程环境优先。
LISTEN_ADDR=127.0.0.1:8080                    # 监听地址。
PUBLIC_URL=https://donate.example.com         # 对外站点地址，生产环境使用 HTTPS。
DATA_DIR=.                                    # 数据库、日志和备份位置，默认当前目录。
LOG_LEVEL=INFO                                # 日志级别：DEBUG / INFO / WARN / ERROR。
APP_SECRET=""                                 # 必填：Base64 编码的 32 字节随机密钥；生成：openssl rand -base64 32；部署后保持不变。
ADMIN_USER_IDS=""                             # 管理员站内 ID，逗号分隔；登录取得 ID 后填入，重启生效。
REAL_IP_HEADER=""                             # 真实 IP 请求头，如 X-Real-IP；留空使用连接 IP，填写时须由可信反代覆盖该头。
UMAMI_SCRIPT_URL=""                           # 可选 Umami 脚本完整地址，如 https://stats.example.com/script.js；两项均留空关闭。
UMAMI_WEBSITE_ID=""                           # Umami 网站 ID；与脚本地址同时填写，启动时注入前端，修改后重启。

OIDC_ISSUER=""                                # OIDC 发行者地址；留空关闭 OIDC 登录。
OIDC_CLIENT_ID=""                             # OIDC 客户端 ID。
OIDC_CLIENT_SECRET=""                         # OIDC 客户端密钥，按服务端要求填写。
OIDC_ID=oidc                                  # 回调 /api/v1/user/oauth/callback/<id>；1–32 位小写字母、数字、_ 或 -，字母开头，不可为 qq。
OIDC_NAME=OIDC                                # 登录和绑定入口显示的名称。
OIDC_ICON_URL=""                              # 可选 HTTPS 图标地址，留空使用通用图标。
QQ_APP_ID=""                                  # QQ 互联应用 ID；留空关闭 QQ 登录。
QQ_APP_SECRET=""                              # QQ 互联应用密钥。
QQ_USE_UNIONID=false                          # 使用 UnionID 绑定，仍保存 OpenID；需先取得权限，开启后缺失 UnionID 将拒绝登录。

EPAY_URL=""                                   # 彩虹易支付网关地址；留空关闭支付。
EPAY_PID=""                                   # 易支付商户 ID。
EPAY_PROTOCOL=v2                              # 接口版本：v2 / v1。
EPAY_PRIVATE_KEY_FILE=""                      # V2 商户私钥文件；也可用 EPAY_PRIVATE_KEY 填写 PEM 或 Base64 内容。
EPAY_PUBLIC_KEY_FILE=""                       # V2 平台公钥文件；也可用 EPAY_PUBLIC_KEY 填写 PEM 或 Base64 内容。
EPAY_KEY=""                                   # V1 商户密钥，仅 EPAY_PROTOCOL=v1 时使用。
EPAY_REDIRECT_HOSTS=""                        # 额外允许的完整支付跳转域名，逗号分隔；网关自身域名自动允许。

GEO_MODE=online                               # 属地查询：online / local / disabled。
GEO_XDB_IPV4=""                               # local 模式优先使用的 IPv4 XDB，如 ./ip2region_v4.xdb。
GEO_XDB_IPV6=""                               # local 模式优先使用的 IPv6 XDB，如 ./ip2region_v6.xdb；可只配置一种协议。
GEO_DATABASE=""                               # 可选 City MMDB；XDB 未命中或缺省份时使用，如 ./GeoLite2-City.mmdb。
GEO_ONLINE_FALLBACK=true                      # 本地结果允许在线核验及补充；冲突时追加来源核对；纯离线设 false，不兜底文件启动错误。
