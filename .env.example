# 通过进程环境或 systemd EnvironmentFile 加载；程序不会自动读取 .env。
APP_ENV=production
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_URL=https://donate.example.com
DATA_DIR=/var/lib/donate
LOG_LEVEL=INFO
# 必填：Base64 编码的 32 字节随机密钥，部署后保持不变。
APP_SECRET=
# 正常登录取得站内 ID 后填入，多个 ID 用逗号分隔，重启生效。
ADMIN_USER_IDS=
# 只信任实际反代来源；没有反代留空。
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
QQ_APP_ID=
QQ_APP_SECRET=

EPAY_URL=
EPAY_PID=
EPAY_PROTOCOL=v2
# V2：商户私钥及平台公钥，优先从权限受限文件加载。
EPAY_PRIVATE_KEY_FILE=
EPAY_PUBLIC_KEY_FILE=
# 也支持 EPAY_PRIVATE_KEY / EPAY_PUBLIC_KEY 的 PEM 或 Base64 内容。
# V1 显式兼容时才使用：
EPAY_KEY=
# 支付跳转额外允许的完整域名，逗号分隔；网关自身域名自动允许。
EPAY_REDIRECT_HOSTS=

# online / local / disabled。local 需合法授权、定期更新的 MMDB。
GEO_MODE=online
GEO_DATABASE=
GEO_ONLINE_FALLBACK=false
