{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!src/generated/*", "!dist", "!playwright-report", "!test-results"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  "html": { "formatter": { "enabled": true } },
  "overrides": [{ "includes": ["src/styles/**"], "linter": { "enabled": false } }]
}
